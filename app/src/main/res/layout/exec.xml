<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:orientation="vertical"
    android:padding="12dp">

    <AutoCompleteTextView
        android:id="@+id/execCommandInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_exec_field"
        android:completionThreshold="1"
        android:fontFamily="monospace"
        android:hint="実行するコマンドを入力"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="#111111"
        android:textColorHint="#7A808A"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/execRunButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="実行"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/execStopButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="停止"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/execCopyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="コピー"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/execSaveButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="save"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/execClearButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="消去"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/execStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="待機中"
            android:textColor="#5A606B"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="タイムアウト "
            android:textColor="#5A606B"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/execTimeoutSpinner"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/execScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_exec_output"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/execOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:hint="出力がここに表示されます"
            android:lineSpacingExtra="2dp"
            android:longClickable="true"
            android:padding="12dp"
            android:textColor="#E8EAED"
            android:textColorHint="#8A9099"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
