<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/findInPageBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_browser_search_bar"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <EditText
        android:id="@+id/etFindQuery"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@null"
        android:hint="ページ内を検索"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#1F1F1F"
        android:textColorHint="#6E7681"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvFindCount"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center"
        android:minWidth="52dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="0/0"
        android:textColor="@color/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnFindPrev"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="前へ"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="▲"
        android:textColor="#1F1F1F" />

    <Button
        android:id="@+id/btnFindNext"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="次へ"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="▼"
        android:textColor="#1F1F1F" />

    <Button
        android:id="@+id/btnFindClose"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="閉じる"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textColor="#1F1F1F" />

</LinearLayout>
