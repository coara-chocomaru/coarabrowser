<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:orientation="horizontal"
    android:padding="12dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:layout_weight="0.43"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/selectFileButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="ファイル選択"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/selectFolderButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="フォルダ選択"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectedInfoText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:minHeight="40dp"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="ファイル未選択"
                    android:textColor="#3C4043"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/clearSelectionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="52dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="解除"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/optionsToggle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="詳細設定 ▼"
                android:textColor="#1558B0"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/optionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="3dp"
                    app:chipSpacingVertical="2dp"
                    app:singleLine="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipI"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="-i 大小無視"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipN"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="-n 行番号"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipV"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-v 反転"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipC"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-c 件数"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipW"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-w 単語"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipX"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-x 行全体"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipO"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-o 一致部分"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipL"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-l ファイル名"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipA"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-a テキスト扱い"
                        android:textAllCaps="false" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="3dp"
                    app:chipSpacingVertical="2dp"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeFixed"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="-F 固定文字列"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeBasic"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-G 基本正規表現"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeExtended"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-E 拡張正規表現"
                        android:textAllCaps="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModePerl"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="-P Perl互換"
                        android:textAllCaps="false" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="A 後"
                            android:textColor="#5A606B"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etAfter"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_exec_field"
                            android:gravity="center"
                            android:hint="行数"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6"
                            android:padding="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#8A9099"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="B 前"
                            android:textColor="#5A606B"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etBefore"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_exec_field"
                            android:gravity="center"
                            android:hint="行数"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6"
                            android:padding="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#8A9099"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="C 前後"
                            android:textColor="#5A606B"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etContext"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_exec_field"
                            android:gravity="center"
                            android:hint="行数"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6"
                            android:padding="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#8A9099"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="m 最大"
                            android:textColor="#5A606B"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etMax"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_exec_field"
                            android:gravity="center"
                            android:hint="件数"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6"
                            android:padding="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#8A9099"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Spinner
                    android:id="@+id/charsetSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/grepInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_exec_field"
                android:fontFamily="monospace"
                android:hint="検索語句 / grep -inC2 &quot;text&quot;"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#111111"
                android:textColorHint="#7A808A"
                android:textSize="13sp" />

            <Button
                android:id="@+id/grepButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:text="grep検索を実行"
                android:textAllCaps="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/md5Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="MD5"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sha1Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="SHA-1"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sha256Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="SHA-256"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/sha512Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="SHA-512"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/hashCompareInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_exec_field"
                android:fontFamily="monospace"
                android:hint="照合用ハッシュ値（任意）"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#111111"
                android:textColorHint="#7A808A"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.57"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="待機中"
            android:textColor="#5A606B"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_exec_output"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/resultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:longClickable="true"
                android:padding="14dp"
                android:text="結果が表示されます"
                android:textColor="#E8EAED"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="停止"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/copyResultButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="コピー"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/saveResultButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="保存"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/clearResultButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="消去"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
