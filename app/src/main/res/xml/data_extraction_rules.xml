<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="SecretBrowserPrefs.xml" />
        <exclude domain="sharedpref" path="coara_translate_secret.xml" />
        <exclude domain="sharedpref" path="coara_exec.xml" />
        <include domain="file" path="plugins" />
        <include domain="file" path="background_image" />
        <include domain="file" path="themes" />
    </device-transfer>
</data-extraction-rules>
