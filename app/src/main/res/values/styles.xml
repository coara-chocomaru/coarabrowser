<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CoaraBrowser" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
    </style>

    <style name="Widget.MaterialComponents.Button.IconButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:tint">@color/colorIconTint</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Theme.CoaraBrowser.FullDialog" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
    </style>

    <style name="Theme.CoaraBrowser.Transparent" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.CoaraBrowser.Touchpad" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
    </style>

    <style name="NumButtonBase" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="NumScientificButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#DCEBFF</item>
        <item name="android:textColor">#102A43</item>
    </style>
    <style name="NumDigitButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#F8FAFC</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="NumOperatorButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#1D4ED8</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="NumAccentButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#0F766E</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NumClearButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#B91C1C</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="NumEqualButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#15803D</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">3dp</item>
    </style>
    
</resources>
